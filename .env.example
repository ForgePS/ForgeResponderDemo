# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
BASEPATH=
NEXT_PUBLIC_APP_URL=http://localhost:3000${BASEPATH}
NEXT_PUBLIC_DOCS_URL=https://demos.pixinvent.com/vuexy-nextjs-admin-template/documentation

# -----------------------------------------------------------------------------
# Authentication (NextAuth.js)
# -----------------------------------------------------------------------------
NEXTAUTH_BASEPATH=${BASEPATH}/api/auth
NEXTAUTH_URL=http://localhost:3000${BASEPATH}/api/auth
NEXTAUTH_SECRET=

# Google OAuth 2.0 (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
DATABASE_URL=

# -----------------------------------------------------------------------------
# API
# -----------------------------------------------------------------------------
API_URL=http://localhost:3000${BASEPATH}/api
NEXT_PUBLIC_API_URL=${API_URL}

# -----------------------------------------------------------------------------
# Mapbox
# -----------------------------------------------------------------------------
MAPBOX_ACCESS_TOKEN=


# -----------------------------------------------------------------------------
# Forge Platform integration
# -----------------------------------------------------------------------------
# demo      = use local sanitized/persistent demo data only
# connected = require Forge Platform API
# auto      = try Forge Platform API, fall back to demo data if unavailable
FORGE_PLATFORM_MODE=demo
FORGE_PLATFORM_API_URL=http://localhost:4000
FORGE_PLATFORM_TENANT_ID=forge-demo

# Local development only. Use the same JSON principal format accepted by Forge Platform.
FORGE_PLATFORM_DEV_PRINCIPAL=
# Optional bearer token for authenticated connected environments.
FORGE_PLATFORM_BEARER_TOKEN=
